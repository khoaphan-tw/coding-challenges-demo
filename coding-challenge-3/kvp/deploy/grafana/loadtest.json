  {
   "type": "timeseries",
   "title": "Time to assign a driver (ms) p50 / p95",
   "description": "POST /rides until the ride shows DRIVER_ASSIGNED, measured by the k6 client (exact, unlike the service-side histogram).",
   "datasource": {
    "type": "prometheus",
