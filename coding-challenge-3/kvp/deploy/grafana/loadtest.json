    },
    "colorMode": "value"
   }
  },
  {
   "type": "row",
   "title": "Traffic (what k6 sent)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Throughput by endpoint (req/s)",
   "description": "Requests per second reaching the gateway. The curve flattening while the target keeps rising is the saturation point.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "interval": "5s",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(k6_http_reqs_total{testid=\"$testid\",name!=\"seed\"}[15s]))",
     "legendFormat": "{{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 25,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Responses by status (req/s)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 6,
    "h": 8
   },
   "interval": "5s",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(k6_http_reqs_total{testid=\"$testid\",name!=\"seed\"}[15s]))",
     "legendFormat": "{{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 25,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Virtual users",
   "description": "In an open (arrival-rate) test, VUs growing means responses are slow: k6 needs more concurrent workers to keep the rate.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 6,
    "w": 6,
    "h": 8
   },
   "interval": "5s",
   "targets": [
    {
     "refId": "A",
     "expr": "sum(k6_vus{testid=\"$testid\"})",
     "legendFormat": "active VUs"
    },
    {
     "refId": "B",
     "expr": "sum(k6_vus_max{testid=\"$testid\"})",
     "legendFormat": "allocated"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
