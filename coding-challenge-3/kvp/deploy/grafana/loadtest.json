    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 23,
    "w": 8,
    "h": 8
   },
   "interval": "5s",
   "targets": [
    {
     "refId": "A",
     "expr": "1000 * histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket[30s])))",
     "legendFormat": "{{job}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
